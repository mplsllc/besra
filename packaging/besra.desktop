[Desktop Entry]
Type=Application
Name=Besra
GenericName=Web Browser
Comment=A lightweight, independent web engine for the readable modern web
Exec=sh -c 'mkdir -p "$HOME/.local/state/besra"; exec besra -V "$HOME/.local/state/besra/besra.log" "$@"' sh %u
Icon=besra
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
